# Copy to generated.env and fill in after Entra app registration.
# Automated: scripts/entra/register-apps.ps1
# Manual:     docs/entra-portal-setup.md

ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_API_CLIENT_ID=your-api-app-client-id
ENTRA_API_AUDIENCE=api://your-api-app-client-id
ENTRA_DASHBOARD_CLIENT_ID=your-dashboard-app-client-id
ENTRA_API_SCOPE=api://your-api-app-client-id/predict

# Keep false until Entra tested end-to-end
ENTRA_AUTH_ENABLED=false

# env | entra | dual
AUTH_MODE=env
