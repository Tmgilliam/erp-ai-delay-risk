# ERP AI — Feature Flags (copy to .env or set in Container Apps)
# Defaults below keep paid Azure services OFF until subscription is active.

# --- Auth mode (dashboard) ---
# env   = DASH_USER/DASH_PASS (portfolio default, no cost)
# entra = Microsoft Entra ID device code flow (free tenant)
# dual  = both options available
AUTH_MODE=env
DASH_USER=demo@erp-ai.local
DASH_PASS=changeme
DASH_ROLE=EXEC

# --- Entra ID (FREE to register — enable when ready) ---
ENTRA_AUTH_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_DASHBOARD_CLIENT_ID=
ENTRA_API_SCOPE=

# --- APIM (PAID — ~$50/month Developer tier) ---
APIM_ENABLED=false
APIM_GATEWAY_URL=
API_BACKEND_URL=http://127.0.0.1:8001

# --- Azure workload (PAID — enable with deploy.ps1) ---
AZURE_STORAGE_ACCOUNT_NAME=
MODEL_BLOB_CONTAINER=models
MODEL_BLOB_NAME=delay_model.pkl
MODEL_PATH=/tmp/delay_model.pkl
